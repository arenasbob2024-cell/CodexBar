{
  "name": "codexbar-mcp",
  "private": true,
  "description": "Stdio MCP server that reports CodexBar provider quotas via the local codexbar CLI or codexbar serve.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p .",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "start": "node dist/src/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.3"
  }
}
